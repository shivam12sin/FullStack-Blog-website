<div class="author hero">

  <h1 class="author__heading display-lg">Candor</h1>
  <p class="author__body body-lg">Discover ideas, stories, and expertise from writers everywhere. Each entry is set like a fresh sheet in a growing manuscript.</p>

</div>

<section class="articles ledger">
  <div class="articles__heading">

    <h2>Top Stories</h2>
  </div>
  <ul class="article-ul">
    <% data.forEach(post => { %>
    <li class="article-card">
      <div class="article-card__header">
        <a href="/post/<%= post._id %>" class="article-title"><%= post.title %></a>
        <% if (post.author) { %>
          <a href="/author/<%= post.author._id %>" class="article-author-tag">by <%= post.author.username %></a>
        <% } %>
      </div>
      <% if (post.excerpt) { %>
        <p class="article-excerpt"><%= post.excerpt %></p>
      <% } %>
      <% if (post.tags && post.tags.length > 0) { %>
        <div class="article-card__tags">
          <% post.tags.forEach(tag => { %>
            <a href="/tag/<%= tag %>" class="tag-chip"><%= tag %></a>
          <% }) %>
        </div>
      <% } %>
      <div class="article-card__meta">
        <span class="label-md">Published <%= post.createdAt.toDateString() %> · <%= post.readingTime %> min read</span>
        <span class="upvote-badge" title="Upvotes">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 4L3 15h6v5h6v-5h6L12 4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          </svg>
          <%= post.upvoteCount || 0 %>
        </span>
      </div>
    </li>
    <% }) %>
  </ul>
  <% if (nextPage!==null) { %>
    <a href="/?page=<%= nextPage%>" class="pagination">View More Posts</a>
  <% } %>
</section>
